# =================================================================
# Library Hub Nawalpur — Backend Environment Configuration Template
# Copy this file to `backend/.env` and supply actual environment values.
# =================================================================

# Server
PORT=5001
NODE_ENV=development
TZ=Asia/Kolkata
LOG_LEVEL=debug

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/library_hub

# JWT Session Security
# Generate a strong 64-char key in production: `openssl rand -hex 32`
JWT_SECRET=dev_jwt_secret_library_hub_nawalpur_super_secure_key_123
JWT_EXPIRES_IN=7d

# Google OAuth (For Student Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Set to 'true' to enable local mock authentication for offline testing
MOCK_GOOGLE_AUTH=true

# Email Service (Nodemailer / SMTP)
# In development, MOCK_MODE is enabled by default to prevent sending real emails
EMAIL_MOCK_MODE=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Library Hub Nawalpur" <noreply@libraryhub.in>

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Initial Seed Super Admin (Used only for local first-time provisioning via `npm run seed`)
SEED_ADMIN_NAME="Library Hub Admin"
SEED_ADMIN_EMAIL=admin@libraryhub.in
SEED_ADMIN_PASSWORD=Admin@LibraryHub2025

